#!/bin/sh
# Format with the CI toolchain so a commit matches `cargo fmt --all -- --check`.

set -e

cd "$(git rev-parse --show-toplevel)"

if ! command -v rustup >/dev/null 2>&1; then
  echo "pre-commit: rustup is required" >&2
  exit 1
fi

if ! rustup toolchain list | grep -q '^1.85.0'; then
  echo "pre-commit: install Rust 1.85.0 (the CI toolchain)" >&2
  exit 1
fi

RUSTUP_TOOLCHAIN=1.85.0 cargo fmt --all

staged=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.rs$' || true)
if [ -n "$staged" ]; then
  printf '%s\n' "$staged" | git add --pathspec-from-file=-
fi
